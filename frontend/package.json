{
  "name": "mnq-chart",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/chart.ts --bundle --format=esm --target=es2022 --outfile=../src/mnq_research/chart_assets/chart.js",
    "test": "esbuild src/ranges.ts src/indicator-values.ts --bundle --format=esm --platform=node --outdir=.test-build --out-extension:.js=.mjs && node --test tests/*.test.mjs",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests"
  },
  "dependencies": {
    "lightweight-charts": "5.0.9"
  },
  "devDependencies": {
    "esbuild": "0.25.5",
    "prettier": "3.5.3",
    "typescript": "5.8.3"
  }
}
